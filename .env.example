# ─── Shopify (app créée dans le Partner Dashboard) ──────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Scopes demandés à l'installation (read_checkouts / read_all_orders selon
# l'accès accordé à votre app par Shopify)
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_pixels,write_pixels,read_customer_events
# URL publique de l'app (sans slash final), ex: https://app.orkestra.io
SHOPIFY_APP_URL=

# ─── Base de données (PostgreSQL — Supabase ou autre) ────────────────────────
# Supabase : Settings → Database → Connection string (URI, port 5432 ou 6543)
DATABASE_URL=
# Optionnel — utilisés si vous passez par l'API Supabase plutôt que Postgres direct
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sécurité ────────────────────────────────────────────────────────────────
# 32+ caractères aléatoires : chiffre les tokens Shopify (AES-256-GCM)
# et signe le state OAuth. `openssl rand -hex 32`
ENCRYPTION_SECRET=
