# ─── Shopify OAuth (FACULTATIF) ─────────────────────────────────────────────
# Deux façons de connecter une boutique :
#   1. Token Admin API (shpat_…) : saisi directement dans l'interface, aucune
#      variable ci-dessous n'est nécessaire.
#   2. App du nouveau Shopify Dev Dashboard : Client ID + Client Secret saisis
#      dans l'interface (Paramètres → Connexion → « J'ai une app Dev Dashboard »),
#      stockés chiffrés en base. Aucune variable ci-dessous n'est nécessaire.
#
# Les variables ci-dessous ne servent QUE si vous préférez configurer une app
# OAuth historique (Partner Dashboard) via l'environnement plutôt que l'UI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Scopes demandés à l'installation
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory,read_pixels,write_pixels,read_customer_events
# URL publique de l'app (sans slash final), ex: https://app.orkestra.io
# Sert aussi à pré-remplir les URLs à copier dans le Dev Dashboard.
SHOPIFY_APP_URL=

# ─── Base de données (PostgreSQL — Supabase ou autre) ────────────────────────
# Supabase : Settings → Database → Connection string (URI, port 5432 ou 6543)
DATABASE_URL=
# Optionnel — utilisés si vous passez par l'API Supabase plutôt que Postgres direct
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sécurité ────────────────────────────────────────────────────────────────
# 32+ caractères aléatoires : chiffre les tokens Shopify (AES-256-GCM)
# et signe le state OAuth. `openssl rand -hex 32`
ENCRYPTION_SECRET=

# ─── URL publique (facultatif) ───────────────────────────────────────────────
# Domaine stable de l'app, exposé au client. Si absent, l'app utilise l'origine
# réelle de la page (et VERCEL_URL côté serveur). Sert aux URLs Dev Dashboard.
NEXT_PUBLIC_APP_URL=

# ─── Migrations sans terminal (facultatif mais recommandé) ───────────────────
# Secret protégeant POST /api/system/migrate (applique les migrations depuis
# l'app déployée). Sans ce secret, la route est inerte. `openssl rand -hex 24`
MIGRATION_SECRET=
